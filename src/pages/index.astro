---
import Base from "../layouts/Base.astro";

const pages = [
  {
    href: "/voortekening",
    kind: "Uitleg",
    title: "Voortekening",
    text: "Sleep van zeven mollen naar zeven kruisen en zie de notenbalk veranderen. Leer de twee regels waarmee je de toonsoort in vijf seconden vindt.",
  },
  {
    href: "/toonladders-oefenen",
    kind: "Oefenen",
    title: "Toonladders oefenen",
    text: "Van voortekening naar toonladder en terug, plus de parallelle klein- of grootladder. Elk antwoord krijgt uitleg met de regel erbij.",
  },
  {
    href: "/maatsoorten",
    kind: "Uitleg",
    title: "Maatsoorten",
    text: "Luister naar 2/4, 3/4, 4/4, 6/8 en meer, kijk hoe een maat zich laat opdelen en hoe je één tel op verschillende manieren vult.",
  },
];
---
<Base title="Tovertoon" description="Muziektheorie om mee te spelen: voortekening, toonladders en maatsoorten, met geluid en oefeningen.">
  <main>
    <header>
      <h1>Muziektheorie om mee te spelen</h1>
      <p class="lead">Korte, interactieve lessen met geluid en oefeningen. Je hoeft niets te installeren en niets in te vullen.</p>
    </header>

    <section aria-labelledby="index">
      <h2 id="index">Alle lessen</h2>
      <ul class="cards">
        {pages.map((p) => (
          <li>
            <a class="card" href={p.href}>
              <span class="kind">{p.kind}</span>
              <b>{p.title}</b>
              <span class="text">{p.text}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="about">
      <h2>Handig om te weten</h2>
      <ul>
        <li>Noten staan als <b>Do Re Mi</b> of als letters (ABC). Je keuze wordt onthouden in je browser.</li>
        <li>Geluid start pas na een klik, zoals browsers het vragen.</li>
        <li>Een goede volgorde: eerst <b>Voortekening</b>, dan <b>Toonladders oefenen</b>, daarna <b>Maatsoorten</b>.</li>
      </ul>
    </section>
  </main>
</Base>

<style>
  main { max-width: 820px; margin: 0 auto; display: flex; flex-direction: column; gap: 32px; }
  h1 {
    font: 800 clamp(34px, 7.5vw, 56px) / 1.03 var(--display);
    letter-spacing: -0.02em;
    margin: 6px 0 12px;
    text-wrap: balance;
  }
  h2 { font: 800 24px / 1.15 var(--display); margin: 0 0 14px; }
  .lead { font-size: 19px; color: var(--muted); max-width: 52ch; margin: 0; }
  .cards { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr)); }
  .card {
    display: flex; flex-direction: column; gap: 8px; height: 100%; box-sizing: border-box;
    text-decoration: none; color: inherit;
    background: var(--card); border: 2px solid var(--ink); border-radius: 20px; padding: 20px;
    transition: transform 0.1s, background 0.15s;
  }
  .card:hover { background: var(--sun); color: #1d1b3a; transform: translateY(-2px); }
  .card:focus-visible { outline: 3px solid var(--violet); outline-offset: 3px; }
  .card b { font: 800 24px / 1.1 var(--display); }
  .card .text { opacity: 0.85; }
  .kind { font: 600 12px var(--body); letter-spacing: 0.08em; text-transform: uppercase; color: var(--violet); }
  .card:hover .kind { color: #1d1b3a; }
  .about { background: var(--card); border: 2px solid var(--ink); border-radius: 20px; padding: 20px; }
  .about ul { margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 6px; }
  @media (prefers-reduced-motion: reduce) { .card { transition: none; } }
</style>
