---
import Base from "../layouts/Base.astro";
import "../styles/components.css";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<Base title="Toonladders spelen" description="Bouw een toonladder op een klavier: klik de noten van laag naar hoog, met het patroon van hele en halve tonen als hulp.">
  <main>
    <header>
      <h1>Toonladders spelen</h1>
      <p class="muted">Bouw de toonladder zelf: klik de noten op het klavier van laag naar hoog. Weet je het patroon niet meer? Lees het na op <a href={`${base}/toonladders-bouwen`}>Toonladders bouwen</a>.</p>
    </header>

    <div class="grp"><span class="lab">Noten</span>
      <div class="seg" id="names" role="group" aria-label="Notennamen">
        <button type="button" data-n="do">Do Re Mi</button><button type="button" data-n="abc">ABC</button>
      </div></div>

    <section class="box" aria-labelledby="h-oef">
      <h2 id="h-oef">Bouw de toonladder</h2>
      <div class="bar">
        <div class="grp"><span class="lab">Soort</span><div class="seg" id="okind" role="group" aria-label="Soort">
          <button type="button" data-v="maj">Groot</button><button type="button" data-v="nat">Klein</button><button type="button" data-v="all">Alles</button></div></div>
        <div class="grp"><span class="lab">Beginnoten</span><div class="seg" id="olevel" role="group" aria-label="Beginnoten">
          <button type="button" data-v="easy">Witte toetsen</button><button type="button" data-v="all">Alle</button></div></div>
      </div>
      <h3 id="oq"></h3>
      <p class="muted" id="ohint"></p>
      <div class="seqrow" id="seq" aria-live="polite"></div>
      <svg id="okbd" class="kbd" role="group" aria-label="Klavier om op te klikken"></svg>
      <div class="fb" id="ofb" aria-live="polite"></div>
      <div class="bar"><button type="button" class="go sec" id="reset">Opnieuw</button><button type="button" class="go sec" id="show">Toon het patroon</button></div>
      <div class="stats" id="ostats"></div>
    </section>
  </main>
</Base>

<style is:global>
  .seqrow { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; min-height: 40px; }
  .chip { display: inline-flex; align-items: center; justify-content: center; min-width: 40px; height: 36px; padding: 0 10px; border: 2px solid var(--ink); border-radius: 12px; background: var(--card); font: 800 16px var(--display); }
  .chip.ok { background: var(--good); color: #fff; }
  .chip.todo { border-style: dashed; color: var(--muted); }
</style>

<script>
  import { $, nm, bindNames, midi, playMidi, stopSound, playSequence, scalePitches, SCALE_PATTERNS, keyboard, store, save, seg, rnd, makeStats, feedback } from "../lib/music.js";
  import { KIND_NAME, tonicName, tonicPitch, tonicsFor, spell, patternText } from "../lib/scales.js";

  let okind = store("tb-okind", "maj", ["maj", "nat", "all"]);
  let olevel = store("tb-olevel", "easy", ["easy", "all"]);
  const okb = keyboard($("okbd"), (m) => click(m));
  const stats = makeStats($("ostats"), "tb-best");
  let q = null;
  function make() {
    for (let n = 0; n < 200; n++) {
      const k = okind === "all" ? ["maj", "nat", "har", "mel"][rnd(4)] : okind;
      const list = tonicsFor(k).filter((t) => olevel === "all" || t.alter === 0);
      const t = list[rnd(list.length)];
      if (q && q.t.L === t.L && q.t.alter === t.alter && q.kind === k) continue;
      const ps = scalePitches(tonicPitch(t), k);
      return { t, kind: k, ps, i: 1, errors: 0, done: false, hinted: false, recorded: false };
    }
  }
  function oRender() {
    $("oq").textContent = `Bouw ${nm(tonicName(q.t))} ${KIND_NAME[q.kind]}`;
    $("ohint").textContent = q.hinted ? `Stappen: ${patternText(q.kind)}. Elke H is twee toetsen, h is één toets.` : "Klik de noten van laag naar hoog. De beginnoot staat al aan.";
    const seq = $("seq");
    seq.innerHTML = "";
    q.ps.forEach((p, i) => {
      const c = document.createElement("span");
      c.className = "chip " + (i < q.i ? "ok" : "todo");
      c.textContent = i < q.i ? spell(p) : "?";
      seq.append(c);
    });
    const map = {};
    q.ps.forEach((p, i) => { if (i < q.i) map[midi(p)] = { cls: i === 0 ? "tonic" : "good", label: spell(p) }; });
    if (q.flash) map[q.flash] = { cls: "bad", label: "" };
    okb.mark(map);
    if (!q.done) $("ofb").innerHTML = "";
    // "Opnieuw" has nothing to undo before the first note, and the pattern can only be shown once.
    ($("reset") as HTMLButtonElement).disabled = q.i === 1 && !q.done;
    ($("show") as HTMLButtonElement).disabled = q.hinted;
  }
  function click(m) {
    stopSound();
    playMidi(m, 0, 1);
    if (q.done) return;
    const want = q.ps[q.i];
    if (m === midi(want)) {
      q.flash = null;
      q.i++;
      if (q.i === q.ps.length) {
        q.done = true;
        if (!q.recorded) { q.recorded = true; stats.record(q.errors === 0); } // a round counts once, however often it is repeated
        oRender();
        playSequence(q.ps, 0.3);
        const pat = patternText(q.kind);
        feedback($("ofb"), q.errors === 0, q.errors === 0 ? "Zonder fout!" : `Gelukt, met ${q.errors} ${q.errors === 1 ? "fout" : "fouten"}.`, `${nm(tonicName(q.t))} ${KIND_NAME[q.kind]}: ${q.ps.map(spell).join(" – ")}. Stappen: ${pat}.`, () => { q = make(); oRender(); });
        return;
      }
    } else {
      q.errors++;
      q.flash = m;
      setTimeout(() => { if (q.flash === m) { q.flash = null; oRender(); } }, 700);
    }
    oRender();
  }
  $("reset").onclick = () => { q.i = 1; q.done = false; q.flash = null; $("ofb").innerHTML = ""; oRender(); };
  $("show").onclick = () => { q.hinted = true; oRender(); };
  seg($("okind"), okind, (v) => { okind = v; save("tb-okind", v); q = make(); oRender(); });
  seg($("olevel"), olevel, (v) => { olevel = v; save("tb-olevel", v); q = make(); oRender(); });

  bindNames($("names"), () => oRender());
  q = make(); oRender();
</script>
