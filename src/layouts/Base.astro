---
import "@fontsource-variable/bricolage-grotesque";
import "@fontsource/dm-sans/400.css";
import "@fontsource/dm-sans/600.css";
import "@fontsource/noto-music/400.css";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  /** Content width of the page, so the nav lines up with it. */
  wrap?: string;
}
const { title, description = "Muziektheorie om mee te spelen.", wrap = "820px" } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const path = Astro.url.pathname.replace(/\/$/, "");
const groups = [
  { label: "Noten lezen", links: [
    { href: `${base}/notenbalk`, label: "Notenbalk" },
    { href: `${base}/intervallen`, label: "Intervallen" },
    { href: `${base}/intervallen-oefenen`, label: "Intervallen oefenen" },
    { href: `${base}/dictee`, label: "Melodisch dictee" },
  ] },
  { label: "Toonladders", links: [
    { href: `${base}/voortekening`, label: "Voortekening" },
    { href: `${base}/kwintencirkel`, label: "Kwintencirkel" },
    { href: `${base}/toonladders-bouwen`, label: "Toonladders bouwen" },
    { href: `${base}/toonladders-spelen`, label: "Toonladders spelen" },
    { href: `${base}/toonladders-oefenen`, label: "Toonladders oefenen" },
    { href: `${base}/toonladders-horen`, label: "Toonladders horen" },
  ] },
  { label: "Ritme", links: [
    { href: `${base}/maatsoorten`, label: "Maatsoorten" },
    { href: `${base}/ritme`, label: "Ritme lezen" },
    { href: `${base}/ritme-herkennen`, label: "Ritme herkennen" },
    { href: `${base}/ritme-volgorde`, label: "Ritme volgorde" },
    { href: `${base}/ritme-dictee`, label: "Ritme dictee" },
  ] },
];
---
<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="referrer" content="no-referrer" />
    <meta
      http-equiv="Content-Security-Policy"
      content={`default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ${import.meta.env.DEV ? "'self' ws: wss:" : "'none'"}; media-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'`}
    />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <title>{title === "Tovertoon" ? title : `${title} · Tovertoon`}</title>
  </head>
  <body style={`--wrap:${wrap}`}>
    <nav class="site-nav" aria-label="Hoofdmenu">
      <a class="brand" href={`${base}/`}>Tovertoon</a>
      <button type="button" class="menu-btn" aria-expanded="false" aria-controls="menus">Menu</button>
      <ul class="menus" id="menus">
        {groups.map((g) => (
          <li>
            <details class="menu">
              <summary aria-current={g.links.some((l) => l.href === path) ? "true" : undefined}>{g.label}</summary>
              <ul>
                {g.links.map((l) => (
                  <li><a href={l.href} aria-current={path === l.href ? "page" : undefined}>{l.label}</a></li>
                ))}
              </ul>
            </details>
          </li>
        ))}
      </ul>
    </nav>
    <slot />
    <footer class="site-foot">
      Tovertoon is gratis en open source onder de MIT-licentie. <a href={`${base}/lettertypes.txt`}>Lettertypelicenties</a>
    </footer>
    <script>
      // Wide screens: three dropdowns, one open at a time. Phones: one Menu button that opens every group as a list.
      const nav = document.querySelector(".site-nav") as HTMLElement;
      const btn = nav.querySelector(".menu-btn") as HTMLButtonElement;
      const menus = [...nav.querySelectorAll("details.menu")] as HTMLDetailsElement[];
      const phone = matchMedia("(max-width: 600px)");
      const setNav = (open: boolean) => {
        nav.classList.toggle("open", open);
        btn.setAttribute("aria-expanded", String(open));
        btn.textContent = open ? "Sluit" : "Menu";
        menus.forEach((m) => (m.open = open && phone.matches));
      };
      btn.addEventListener("click", () => setNav(!nav.classList.contains("open")));
      menus.forEach((m) => {
        m.addEventListener("toggle", () => { if (!phone.matches && m.open) menus.forEach((o) => { if (o !== m) o.open = false; }); });
        // on a phone the group titles are headings, not buttons
        m.querySelector("summary")!.addEventListener("click", (e) => { if (phone.matches) e.preventDefault(); });
      });
      const closeAll = () => (phone.matches ? setNav(false) : menus.forEach((m) => (m.open = false)));
      document.addEventListener("click", (e) => { if (!(e.target as Element).closest(".site-nav")) closeAll(); });
      document.addEventListener("keydown", (e) => {
        if (e.key !== "Escape") return;
        if (phone.matches) { if (nav.classList.contains("open")) { setNav(false); btn.focus(); } }
        else menus.forEach((m) => { if (m.open) { m.open = false; (m.querySelector("summary") as HTMLElement).focus(); } });
      });
      phone.addEventListener("change", () => setNav(false));
    </script>
  </body>
</html>
