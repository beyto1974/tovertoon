---
import "@fontsource-variable/bricolage-grotesque";
import "@fontsource/dm-sans/400.css";
import "@fontsource/dm-sans/600.css";
import "@fontsource/noto-music/400.css";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  /** Content width of the page, so the nav lines up with it. */
  wrap?: string;
}
const { title, description = "Muziektheorie om mee te spelen.", wrap = "820px" } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "");
const links = [
  { href: "/voortekening", label: "Voortekening" },
  { href: "/toonladders-oefenen", label: "Toonladders oefenen" },
  { href: "/maatsoorten", label: "Maatsoorten" },
];
---
<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title === "Tovertoon" ? title : `${title} · Tovertoon`}</title>
  </head>
  <body style={`--wrap:${wrap}`}>
    <nav class="site-nav" aria-label="Hoofdmenu">
      <a class="brand" href="/">Tovertoon</a>
      <ul>
        {links.map((l) => (
          <li><a href={l.href} aria-current={path === l.href ? "page" : undefined}>{l.label}</a></li>
        ))}
      </ul>
    </nav>
    <slot />
    <footer class="site-foot">
      Tovertoon is gratis en open source onder de MIT-licentie.
    </footer>
  </body>
</html>
